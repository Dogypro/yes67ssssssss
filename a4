--[[ ---------- value serialisation ---------- ]]

local function shortValue(v)
	local t = typeof(v);
	if t == "string" then
		if #v > 300 then v = string.sub(v, 1, 300) .. "..."; end
		return string.format("%q", v);
	elseif t == "number" or t == "boolean" then
		return tostring(v);
	elseif t == "nil" then
		return "nil";
	elseif t == "Vector3" then
		return string.format("Vector3(%.2f, %.2f, %.2f)", v.X, v.Y, v.Z);
	elseif t == "Vector2" then
		return string.format("Vector2(%.2f, %.2f)", v.X, v.Y);
	elseif t == "CFrame" then
		local p = v.Position;
		return string.format("CFrame(%.2f, %.2f, %.2f)", p.X, p.Y, p.Z);
	elseif t == "Color3" then
		return string.format("Color3(%d, %d, %d)", v.R * 255, v.G * 255, v.B * 255);
	elseif t == "UDim2" then
		return string.format("UDim2(%.2f, %d, %.2f, %d)",
			v.X.Scale, v.X.Offset, v.Y.Scale, v.Y.Offset);
	elseif t == "EnumItem" then
		return tostring(v);
	elseif t == "Instance" then
		return "<" .. v.ClassName .. " " .. v:GetFullName() .. ">";
	elseif t == "function" then
		return "<function>";
	end
	return "<" .. t .. ">";
end

local function serialize(value, depth, seen, out)
	depth = depth or 0;
	seen = seen or {};
	out = out or {};

	if type(value) ~= "table" then
		table.insert(out, shortValue(value));
		return out;
	end

	if seen[value] then
		table.insert(out, "<cycle>");
		return out;
	end
	if depth >= CONFIG.MaxTableDepth then
		table.insert(out, "{...}");
		return out;
	end
	seen[value] = true;

	local pad = string.rep("  ", depth + 1);
	local closePad = string.rep("  ", depth);
	local keys = {};
	for k in pairs(value) do table.insert(keys, k); end

	if #keys == 0 then
		table.insert(out, "{}");
		seen[value] = nil;
		return out;
	end

	table.sort(keys, function(a, b) return tostring(a) < tostring(b); end);
	table.insert(out, "{\n");

	for _, k in ipairs(keys) do
		table.insert(out, pad .. "[" .. shortValue(k) .. "] = ");
		local ok = pcall(function()
			serialize(value[k], depth + 1, seen, out);
		end);
		if not ok then table.insert(out, "<error>"); end
		table.insert(out, ",\n");
	end

	table.insert(out, closePad .. "}");
	seen[value] = nil;
	return out;
end

