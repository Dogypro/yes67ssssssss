--[[ ---------- the dump ---------- ]]

local counters = {instances = 0, scripts = 0, modules = 0, remotes = 0, sourced = 0};
local summaryText = "";
local running = false;

local function dumpAll()
	if running then return; end
	running = true;
	dumpBtn.Text = "Working...";
	counters = {instances = 0, scripts = 0, modules = 0, remotes = 0, sourced = 0};

	local treeLines = {};
	local remoteLines = {};
	local moduleLines = {};
	local scriptLines = {};
	local modulesToLoad = {};
	local processed = 0;

	local function walk(inst, depth)
		if depth > CONFIG.MaxDepth then return; end

		processed = processed + 1;
		counters.instances = counters.instances + 1;

		if processed % CONFIG.YieldEvery == 0 then
			say("Scanning... " .. counters.instances .. " objects");
			task.wait();
		end

		local pad = string.rep("  ", depth);
		local line = pad .. inst.ClassName .. ' "' .. inst.Name .. '"';

		local propList = PROPS[inst.ClassName];
		if propList then
			local bits = {};
			for _, propName in ipairs(propList) do
				local ok, v = pcall(function() return inst[propName]; end);
				if ok and v ~= nil then
					table.insert(bits, propName .. "=" .. shortValue(v));
				end
			end
			if #bits > 0 then line = line .. "  [" .. table.concat(bits, ", ") .. "]"; end
		end

		table.insert(treeLines, line);

		if inst:IsA("RemoteEvent") or inst:IsA("RemoteFunction")
			or inst:IsA("BindableEvent") or inst:IsA("BindableFunction") then
			counters.remotes = counters.remotes + 1;
			table.insert(remoteLines, inst.ClassName .. "  " .. inst:GetFullName());
		end

		if inst:IsA("LuaSourceContainer") then
			counters.scripts = counters.scripts + 1;
			local gotSource, source = pcall(function() return inst.Source; end);
			if gotSource and type(source) == "string" and #source > 0 then
				counters.sourced = counters.sourced + 1;
				table.insert(scriptLines, string.rep("=", 70));
				table.insert(scriptLines, inst:GetFullName() .. "  [" .. inst.ClassName .. "]");
				table.insert(scriptLines, string.rep("=", 70));
				table.insert(scriptLines, source);
				table.insert(scriptLines, "");
			end
			if inst:IsA("ModuleScript") then
				table.insert(modulesToLoad, inst);
			end
		end

		local ok, kids = pcall(function() return inst:GetChildren(); end);
		if ok then
			local n = 0;
			for _, kid in ipairs(kids) do
				n = n + 1;
				if n > CONFIG.MaxChildren then
					table.insert(treeLines, pad .. "  ... truncated");
					break;
				end
				pcall(walk, kid, depth + 1);
			end
		end
	end

	for _, rootName in ipairs(ROOTS) do
		local ok, service = pcall(game.GetService, game, rootName);
		if ok and service then
			table.insert(treeLines, "");
			table.insert(treeLines, string.rep("#", 70));
			table.insert(treeLines, "# " .. rootName);
			table.insert(treeLines, string.rep("#", 70));
			pcall(walk, service, 0);
		end
	end

	local lp = Players.LocalPlayer;
	if lp then
		local pg = lp:FindFirstChild("PlayerGui");
		if pg then
			table.insert(treeLines, "");
			table.insert(treeLines, string.rep("#", 70));
			table.insert(treeLines, "# PlayerGui");
			table.insert(treeLines, string.rep("#", 70));
			pcall(walk, pg, 0);
		end
	end

	--[[ require each module to read its live data ]]

	say("Reading " .. #modulesToLoad .. " modules...");
	task.wait();

	local function safeRequire(m)
		local finished, value = false, nil;
		task.spawn(function()
			local ok, res = pcall(require, m);
			value = ok and res or nil;
			finished = true;
		end);
		local waited = 0;
		while not finished and waited < CONFIG.RequireTimeout do
			task.wait(0.05);
			waited = waited + 0.05;
		end
		return value;
	end

	for i, m in ipairs(modulesToLoad) do
		if i % 15 == 0 then
			say("Modules " .. i .. " / " .. #modulesToLoad);
			task.wait();
		end

		local value = safeRequire(m);
		if value ~= nil then
			counters.modules = counters.modules + 1;
			table.insert(moduleLines, string.rep("=", 70));
			table.insert(moduleLines, m:GetFullName());
			table.insert(moduleLines, string.rep("=", 70));
			local pieces = {};
			pcall(function() serialize(value, 0, {}, pieces); end);
			table.insert(moduleLines, table.concat(pieces));
			table.insert(moduleLines, "");
		end
	end

	--[[ write it out ]]

	summaryText = table.concat({
		"GAME DUMP  --  " .. game.Name,
		"PlaceId  " .. tostring(game.PlaceId),
		"JobId    " .. tostring(game.JobId),
		"Time     " .. os.date("%Y-%m-%d %H:%M:%S"),
		"",
		"Objects        " .. counters.instances,
		"Scripts        " .. counters.scripts,
		"  with source  " .. counters.sourced,
		"Modules read   " .. counters.modules,
		"Remotes        " .. counters.remotes,
		"",
		(counters.sourced == 0)
			and "No script source available. Roblox strips it client side and Delta has no decompiler. Module data below is the real content."
			or  "Some source was readable and is in scripts.txt.",
	}, "\n");

	if not canWrite then
		say("This executor has no writefile. Summary copied instead.");
		if canClip then pcall(setclipboard, summaryText); end
		dumpBtn.Text = "Dump everything";
		running = false;
		return;
	end

	if canFolder then pcall(makefolder, CONFIG.Folder); end

	local files = {
		{"summary.txt", summaryText},
		{"tree.txt", table.concat(treeLines, "\n")},
		{"remotes.txt", table.concat(remoteLines, "\n")},
		{"modules.txt", table.concat(moduleLines, "\n")},
		{"scripts.txt", table.concat(scriptLines, "\n")},
	};

	local written = 0;
	for _, entry in ipairs(files) do
		local name, body = entry[1], entry[2];
		if #body > 0 then
			--[[ split anything huge, mobile chokes on giant writes ]]
			if #body > 4000000 then
				local index, pos = 0, 1;
				while pos <= #body do
					index = index + 1;
					local stop = math.min(pos + 4000000, #body);
					local nl = string.find(body, "\n", stop, true);
					if nl then stop = nl; end
					local ok = pcall(writefile,
						CONFIG.Folder .. "/" .. string.gsub(name, "%.txt", "") .. "_part" .. index .. ".txt",
						string.sub(body, pos, stop));
					if ok then written = written + 1; end
					pos = stop + 1;
					task.wait();
				end
			else
				local ok = pcall(writefile, CONFIG.Folder .. "/" .. name, body);
				if ok then written = written + 1; end
			end
		end
		task.wait();
	end

	say("Saved " .. written .. " files to " .. CONFIG.Folder .. "/\n"
		.. counters.instances .. " objects, " .. counters.modules .. " modules, "
		.. counters.remotes .. " remotes.");

	--[[ optional webhook, summary only, never the whole dump ]]

	if CONFIG.Webhook ~= "" and httpPost then
		local body = game:GetService("HttpService"):JSONEncode({
			content = "```\n" .. string.sub(summaryText, 1, 1800) .. "\n```",
		});
		pcall(function()
			httpPost({
				Url = CONFIG.Webhook,
				Method = "POST",
				Headers = {["Content-Type"] = "application/json"},
				Body = body,
			});
		end);
	end

	dumpBtn.Text = "Dump everything";
	running = false;
end

dumpBtn.MouseButton1Click:Connect(function()
	task.spawn(dumpAll);
end);

copyBtn.MouseButton1Click:Connect(function()
	if summaryText == "" then
		say("Run the dump first.");
		return;
	end
	if canClip then
		pcall(setclipboard, summaryText);
		say("Summary copied to clipboard.");
	else
		say("No setclipboard in this executor.");
	end
end);

say(table.concat({
	"writefile: " .. (canWrite and "yes" or "NO"),
	"clipboard: " .. (canClip and "yes" or "no"),
	"http: " .. (httpPost and "yes" or "no"),
	"",
	"Tap Dump everything.",
}, "\n"));
