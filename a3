	if not isEdit then
		bannerBar.BackgroundColor3 = BAD;
		bannerTitle.TextColor3 = BAD;
		bannerTitle.Text = "PLAY MODE  --  this is why your code is empty";
		bannerBody.Text = "Press the Stop button, then paste this again in Edit mode. "
			.. "The client cannot read Source or use HttpService.";
