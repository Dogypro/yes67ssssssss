		bannerBar.BackgroundColor3 = GOOD;
		bannerTitle.TextColor3 = GOOD;
		bannerTitle.Text = "EDIT MODE  --  " .. readable .. " of " .. #allScripts .. " scripts readable";
		bannerBody.Text = "Use Open in Script Editor to copy everything, "
			.. "or Send to Browser if dump.py is running.";
