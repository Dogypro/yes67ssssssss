--[[ ---------- list rendering ---------- ]]

local current = nil;
local rows = {};

local function show(entry)
	current = entry;
	for _, r in ipairs(rows) do
		r.BackgroundColor3 = (r:GetAttribute("p") == entry.path) and PANEL2 or PANEL;
	end
	pathLabel.Text = entry.path .. "   [" .. entry.class .. "]   " .. entry.lines .. " lines";
	pathLabel.TextColor3 = COLORS[entry.class] or TEXT;
	if entry.ok then
		codeBox.Text = entry.source;
	else
		codeBox.Text = "This script's source could not be read.\n\n"
			.. "See the banner at the top of this window for the reason.";
	end
	codeScroll.CanvasPosition = Vector2.zero;
end

local function renderList()
	for _, child in ipairs(listScroll:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy(); end
	end
	rows = {};

	local filter = string.lower(searchBox.Text);
	local count = 0;

	for i, entry in ipairs(allScripts) do
		local hay = string.lower(entry.path .. " " .. entry.class);
		if filter == "" or string.find(hay, filter, 1, true) then
			count = count + 1;
			local row = make("TextButton", {
				Size = UDim2.new(1, -6, 0, 38),
				BackgroundColor3 = PANEL,
				BorderSizePixel = 0,
				Text = "",
				AutoButtonColor = false,
				LayoutOrder = i,
				Parent = listScroll,
			}, {round(5)});
			row:SetAttribute("p", entry.path);

			make("Frame", {
				Size = UDim2.new(0, 3, 1, -10),
				Position = UDim2.fromOffset(0, 5),
				BackgroundColor3 = COLORS[entry.class] or MUTE,
				BorderSizePixel = 0,
				Parent = row,
			});

			make("TextLabel", {
				Size = UDim2.new(1, -16, 0, 15),
				Position = UDim2.fromOffset(10, 4),
				BackgroundTransparency = 1,
				Text = entry.name,
				TextColor3 = entry.ok and TEXT or BAD,
				TextSize = 12,
				Font = Enum.Font.GothamMedium,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Parent = row,
			});

			make("TextLabel", {
				Size = UDim2.new(1, -16, 0, 13),
				Position = UDim2.fromOffset(10, 20),
				BackgroundTransparency = 1,
				Text = entry.path,
				TextColor3 = MUTE,
				TextSize = 10,
				Font = Enum.Font.Code,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Parent = row,
			});

			row.MouseButton1Click:Connect(function() show(entry); end);
			table.insert(rows, row);
		end
	end
	return count;
end

--[[ ---------- export into Studio's own editor ---------- ]]

local function exportToEditor()
	if readable == 0 then
		say("Nothing readable to export. Fix the problem in the banner first.", BAD);
		return;
	end

	local old = ServerStorage:FindFirstChild("ScriptDump");
	if old then old:Destroy(); end

	local folder = make("Folder", {Name = "ScriptDump", Parent = ServerStorage});

	local bar78 = string.rep("=", 78);
	local pieces = {};
	local count = 0;
	for _, entry in ipairs(allScripts) do
		if entry.ok then
			table.insert(pieces, bar78 .. "\n" .. entry.path .. "  [" .. entry.class
				.. "]  " .. entry.lines .. " lines\n" .. bar78 .. "\n" .. entry.source);
			count = count + 1;
		end
	end
	local dump = table.concat(pieces, "\n\n");

	local made = {};
	local pos = 1;
	local index = 0;
	while pos <= #dump do
		index = index + 1;
		local stop = math.min(pos + 180000, #dump);
		if stop < #dump then
			local nl = string.find(dump, "\n", stop, true);
			if nl then stop = nl; end
		end
		local m = make("ModuleScript", {
			Name = (index == 1 and #dump <= 180000) and "Dump" or ("Dump_Part" .. index),
			Parent = folder,
		});
		local wrote = pcall(function()
			m.Source = "--[==[\n" .. string.sub(dump, pos, stop) .. "\n]==]";
		end);
		if not wrote then m.Source = "-- could not write this chunk"; end
		table.insert(made, m);
		pos = stop + 1;
	end

	pcall(function() game:GetService("Selection"):Set(made); end);

	local editor = game:FindService("ScriptEditorService");
	if editor then
		task.spawn(function()
			for _, m in ipairs(made) do
				pcall(function() editor:OpenScriptDocumentAsync(m); end);
			end
		end);
	end

	say(count .. " scripts written to ServerStorage.ScriptDump ("
		.. #made .. " part(s)). Click the editor tab, then Ctrl+A, Ctrl+C.", GOOD);
end

--[[ ---------- send to the browser viewer ---------- ]]

local function sendToBrowser()
	if not RunService:IsEdit() then
		say("Can't send from Play mode. Press Stop first.", BAD);
		return;
	end
	if readable == 0 then
		say("Nothing readable to send.", BAD);
		return;
	end

	local url = "http://localhost:" .. PORT .. "/api/upload";
	local session = string.format("%d_%d", os.time(), math.random(1000, 9999));
	local batch = {};
	local chars = 0;
	local part = 0;
	local sent = 0;

	for i, entry in ipairs(allScripts) do
		table.insert(batch, entry);
		chars = chars + entry.chars + 200;

		if chars >= BATCH_CHARS or i == #allScripts then
			part = part + 1;
			local body = HttpService:JSONEncode({
				session = session, place = game.Name, placeId = game.PlaceId,
				part = part, final = (i == #allScripts), total = #allScripts,
				scripts = batch,
			});

			local posted, err = pcall(function()
				return HttpService:PostAsync(url, body, Enum.HttpContentType.ApplicationJson, false);
			end);

			if not posted then
				local msg = tostring(err);
				if string.find(msg, "ConnectFail") or string.find(msg, "Timedout") or string.find(msg, "curl") then
					say("Can't reach " .. url .. " -- run  python3 dump.py  first.", BAD);
				elseif string.find(msg, "not enabled") or string.find(msg, "Http requests") then
					say("Turn on Game Settings > Security > Allow HTTP Requests.", BAD);
				else
					say("Send failed: " .. msg .. "  -- use Open in Script Editor instead.", BAD);
				end
				return;
			end

			sent = sent + #batch;
			batch = {};
			chars = 0;
		end
	end

	say("Sent " .. sent .. " scripts. Open http://localhost:" .. PORT, GOOD);
end

