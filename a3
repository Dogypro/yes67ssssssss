--[[ ---------- helpers ---------- ]]

local function make(class, props, kids)
	local o = Instance.new(class);
	for k, v in pairs(props) do
		if k ~= "Parent" then o[k] = v; end
	end
	for _, kid in ipairs(kids or {}) do kid.Parent = o; end
	if props.Parent then o.Parent = props.Parent; end
	return o;
end

local function round(r)
	return make("UICorner", {CornerRadius = UDim.new(0, r or 6)});
end

--[[ ---------- scan ---------- ]]

local allScripts = {};
local readable = 0;

local function scan()
	allScripts = {};
	readable = 0;

	for _, serviceName in ipairs(ROOTS) do
		local hasService, service = pcall(game.GetService, game, serviceName);
		if hasService and service then
			local hasKids, kids = pcall(service.GetDescendants, service);
			if hasKids then
				for _, item in ipairs(kids) do
					local skip = false;
					local dumpFolder = ServerStorage:FindFirstChild("ScriptDump");
					if dumpFolder and item:IsDescendantOf(dumpFolder) then skip = true; end

					if item:IsA("LuaSourceContainer") and not skip then
						local gotIt, source = pcall(function() return item.Source; end);
						local isOk = gotIt and type(source) == "string";
						if isOk then
							readable = readable + 1;
						else
							source = "";
						end
						local _, breaks = string.gsub(source, "\n", "");
						table.insert(allScripts, {
							path = string.gsub(item:GetFullName(), "^game%.", ""),
							name = item.Name,
							class = item.ClassName,
							lines = (source == "") and 0 or (breaks + 1),
							chars = #source,
							source = source,
							ok = isOk,
						});
					end
				end
			end
		end
	end

	table.sort(allScripts, function(a, b)
		return string.lower(a.path) < string.lower(b.path);
	end);
end

scan();

