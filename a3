		bannerBar.BackgroundColor3 = BAD;
		bannerTitle.TextColor3 = BAD;
		bannerTitle.Text = "NO SOURCE ACCESS  --  " .. #allScripts .. " scripts found, 0 readable";
		bannerBody.Text = "Paste this into the Command Bar, not into a Script. "
			.. "Scripts you press Play on can never read Source.";
