--== shotId detection ===============================================
-- BaseShotc.new feeds shotId straight into ResourceUtil:GetResource("Fx", id)
-- and returns nil when the lookup misses, so it has to be read off a real
-- bullet rather than guessed. Bullets you fire yourself still pass through
-- WorldShots.ChildAdded on their way to bindBullet, so they can be sampled.

local shotIdByTool = {}   -- toolId -> shotId, sampled from our own bullets
local fallbackShotId      -- from anyone's bullet, used only if we have nothing

local function record(bullet)
	local shotId = bullet:GetAttribute("shotId")
	if not shotId then
		return
	end
	if bullet:GetAttribute("userId") == lp.UserId then
		local toolId = bullet:GetAttribute("toolId") or "__none"
		if shotIdByTool[toolId] ~= shotId then
			shotIdByTool[toolId] = shotId
			if onDetect then onDetect() end
		end
	elseif not fallbackShotId then
		fallbackShotId = shotId
		if onDetect then onDetect() end
	end
end

local worldShots = workspace:WaitForChild("WorldShots")
for _, b in pairs(worldShots:GetChildren()) do
	record(b)
end
worldShots.ChildAdded:Connect(record)

--== tool / origin ==================================================

local function getTool()
	local char = lp.Character
	return char and char:FindFirstChildWhichIsA("Tool")
end

local function currentToolId()
	local tool = getTool()
	if not tool then
		return nil
	end
	return tool:GetAttribute("toolId") or tool.Name
end

-- returns shotId, isExactMatchForEquippedTool
local function currentShotId()
	local toolId = currentToolId()
	if toolId and shotIdByTool[toolId] then
		return shotIdByTool[toolId], true
	end
	for _, id in pairs(shotIdByTool) do
		return id, false
	end
	return fallbackShotId, false
end

local function getOrigin()
	local tool = getTool()
	if tool then
		local handle = ToolUtil:getToolInstanceHandle(tool)
		local att = handle and handle:FindFirstChild("FireAttachment")
		if att then
			return att.WorldPosition
		end
	end
	local char = lp.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	return hrp and hrp.Position or workspace.CurrentCamera.CFrame.Position
end

