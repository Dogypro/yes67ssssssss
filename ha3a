-- spread slider -------------------------------------------------------
do
	local row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 38),
		BackgroundTransparency = 1,
		LayoutOrder = nextOrder(),
	}, panel)

	local lbl = new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 16),
		BackgroundTransparency = 1,
		Text = "Spread  4.0 deg",
		Font = Enum.Font.Gotham,
		TextSize = 13,
		TextColor3 = COL.text,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, row)

	local hit = new("Frame", {
		Size = UDim2.new(1, 0, 0, 20),
		Position = UDim2.fromOffset(0, 18),
		BackgroundTransparency = 1,
	}, row)

	local track = new("Frame", {
		Size = UDim2.new(1, 0, 0, 5),
		Position = UDim2.new(0, 0, 0.5, -2),
		BackgroundColor3 = COL.row,
		BorderSizePixel = 0,
	}, hit)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, track)

	local fill = new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = COL.accent,
		BorderSizePixel = 0,
	}, track)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, fill)

	local knob = new("Frame", {
		Size = UDim2.fromOffset(12, 12),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = COL.text,
		BorderSizePixel = 0,
		ZIndex = 2,
	}, track)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, knob)

	local MIN_SPREAD, MAX_SPREAD = 0, 25

	local function apply(alpha)
		alpha = math.clamp(alpha, 0, 1)
		cfg.spreadDeg = math.floor((MIN_SPREAD + alpha * (MAX_SPREAD - MIN_SPREAD)) * 10 + 0.5) / 10
		fill.Size = UDim2.fromScale(alpha, 1)
		knob.Position = UDim2.new(alpha, 0, 0.5, 0)
		lbl.Text = string.format("Spread  %.1f deg", cfg.spreadDeg)
	end

	local function setFromX(x)
		if track.AbsoluteSize.X <= 0 then return end
		apply((x - track.AbsolutePosition.X) / track.AbsoluteSize.X)
	end

	apply((cfg.spreadDeg - MIN_SPREAD) / (MAX_SPREAD - MIN_SPREAD))

	local dragging = false
	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

