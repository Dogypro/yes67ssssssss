--== firing =========================================================

-- spawnLocalShot keys its table on tostring(tick()), which only resolves to
-- roughly 10 microseconds. Without nudging the clock between iterations the
-- loop overwrites its own entries and you get 3-4 tracers instead of 10 --
-- and the overwritten ones leak their Fx model under CurrentCamera, since
-- nothing is left holding a reference to call Destroy on.
local function advanceStamp()
	local s0 = tostring(tick())
	repeat until tostring(tick()) ~= s0
end

local firing = false

fireVolley = function()
	if firing then
		return
	end
	if not spawnLocalShot then
		setStatus("shared.spawnLocalShot not available", COL.bad)
		return
	end

	local shotId = currentShotId()
	if not shotId then
		setStatus("no shotId yet -- fire the tool normally once", COL.bad)
		return
	end

	local target = mouse.Hit.Position
	local toolId = currentToolId()
	local maxAngle = math.rad(cfg.spreadDeg)
	local count = cfg.count
	local spaced = cfg.delayMs > 0

	firing = true
	task.spawn(function()
		local fired = 0
		for i = 1, count do
			-- re-read origin each shot so spaced bursts track the hand
			local origin = getOrigin()
			local toTarget = target - origin
			local dist = toTarget.Magnitude

			if dist >= 1 then
				dist = math.min(dist, cfg.maxRange)
				local base = CFrame.lookAt(origin, target)
				local theta = math.random() * math.pi * 2
				-- sqrt keeps the sample density even across the cone face
				local r = math.sqrt(math.random()) * maxAngle
				local dir = (base * CFrame.Angles(0, 0, theta) * CFrame.Angles(r, 0, 0)).LookVector

				local ok = spawnLocalShot({
					userId      = lp.UserId,
					toolId      = toolId,
					shotId      = shotId,
					origin      = origin,
					destination = origin + dir * dist,
				})
				if ok then
					fired = fired + 1
				end
			end

			if i < count then
				if spaced then
					task.wait(cfg.delayMs / 1000)
				else
					advanceStamp()
				end
			end
		end

		firing = false
		if fired == 0 then
			setStatus("0 spawned -- check shotId, or too close", COL.bad)
		elseif fired < count then
			setStatus(string.format("%d/%d spawned", fired, count), COL.warn)
		else
			setStatus(string.format("%d fired", fired), COL.ok)
		end
	end)
end

--== input ==========================================================

UserInputService.InputBegan:Connect(function(input, processed)
	if input.UserInputType ~= Enum.UserInputType.Keyboard then
		return
	end
	if UserInputService:GetFocusedTextBox() then
		return
	end

	if awaitingBind then
		awaitingBind = false
		cfg.triggerKey = input.KeyCode
		bindBtn.Text = input.KeyCode.Name
		bindBtn.TextColor3 = COL.text
		return
	end

	if input.KeyCode == cfg.toggleKey then
		panel.Visible = not panel.Visible
		return
	end
	if processed then
		return
	end
	if input.KeyCode == cfg.triggerKey then
		fireVolley()
	end
end)

--== bootstrap ======================================================

refreshDetect()
task.spawn(function()
	while true do
		task.wait(0.5)
		refreshDetect()
	end
end)

task.spawn(function()
	local t0 = os.clock()
	while not shared.spawnLocalShot and os.clock() - t0 < 20 do
		task.wait(0.1)
	end
	spawnLocalShot = shared.spawnLocalShot
	if spawnLocalShot then
		setStatus("ready", COL.ok)
	else
		setStatus("shared.spawnLocalShot never appeared", COL.bad)
	end
end)
