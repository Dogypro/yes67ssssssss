-- LIST RENDERING
--==============================================================================

local function selectEntry(entry)
	selected = entry

	for _, btn in ipairs(rowButtons) do
		btn.BackgroundColor3 = (btn:GetAttribute("Path") == entry.Path)
			and THEME.Panel2 or THEME.Bg
	end

	headerLabel.Text = ("%s  [%s]  -- %d lines, %d chars")
		:format(entry.Path, entry.Class, entry.Lines, entry.Chars)
	headerLabel.TextColor3 = CLASS_COLOR[entry.Class] or THEME.Text

	local src = entry.Source
	if not src then
		sourceBox.Text = "-- Source could not be read.\n-- " .. tostring(entry.Error)
	elseif #src > CONFIG.MaxPreviewChars then
		sourceBox.Text = src:sub(1, CONFIG.MaxPreviewChars)
			.. "\n\n-- [preview truncated -- use Export to Editor for the full text]"
	else
		sourceBox.Text = src
	end

	sourceScroll.CanvasPosition = Vector2.zero
end

local function buildRow(entry, index)
	local row = new("TextButton", {
		Size = UDim2.new(1, -6, 0, 40),
		BackgroundColor3 = THEME.Bg,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		LayoutOrder = index,
		Parent = listScroll,
	}, { corner(6) })

	row:SetAttribute("Path", entry.Path)

	new("Frame", {
		Size = UDim2.new(0, 3, 1, -10),
		Position = UDim2.fromOffset(0, 5),
		BackgroundColor3 = CLASS_COLOR[entry.Class] or THEME.TextDim,
		BorderSizePixel = 0,
		Parent = row,
	}, { corner(2) })

	new("TextLabel", {
		Size = UDim2.new(1, -60, 0, 16),
		Position = UDim2.fromOffset(10, 4),
		BackgroundTransparency = 1,
		Text = entry.Name,
		TextColor3 = entry.Source and THEME.Text or THEME.Bad,
		TextSize = 13,
		Font = Enum.Font.GothamMedium,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = row,
	})

	new("TextLabel", {
		Size = UDim2.new(1, -60, 0, 14),
		Position = UDim2.fromOffset(10, 21),
		BackgroundTransparency = 1,
		Text = entry.Path,
		TextColor3 = THEME.TextDim,
		TextSize = 11,
		Font = Enum.Font.Code,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = row,
	})

	new("TextLabel", {
		Size = UDim2.fromOffset(44, 40),
		Position = UDim2.new(1, -48, 0, 0),
		BackgroundTransparency = 1,
		Text = entry.Lines .. "L",
		TextColor3 = THEME.TextDim,
		TextSize = 11,
		Font = Enum.Font.Code,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = row,
	})

	row.MouseEnter:Connect(function()
		if selected ~= entry then row.BackgroundColor3 = THEME.Panel2 end
	end)
	row.MouseLeave:Connect(function()
		if selected ~= entry then row.BackgroundColor3 = THEME.Bg end
	end)
	row.MouseButton1Click:Connect(function() selectEntry(entry) end)

	table.insert(rowButtons, row)
end

local function renderList()
	for _, child in ipairs(listScroll:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	table.clear(rowButtons)

	local filter = searchBox.Text:lower()
	local shown, unreadable = 0, 0

	for i, entry in ipairs(allScripts) do
		if matchesFilter(entry, filter) then
			buildRow(entry, i)
			shown += 1
			if not entry.Source then unreadable += 1 end
		end
	end

	local msg = ("%d of %d scripts shown"):format(shown, #allScripts)
	if unreadable > 0 then msg ..= (" (%d unreadable)"):format(unreadable) end
	setStatus(msg)
end

local function rescan()
	setStatus("Scanning...")
	allScripts = collectScripts()
	selected = nil
	headerLabel.Text = "Select a script from the list"
	headerLabel.TextColor3 = THEME.TextDim
	sourceBox.Text = ""
	renderList()
end

