showAllBtn.MouseButton1Click:Connect(function()
	local dump, count = buildDump()
	if count == 0 then
		setStatus("Nothing matches the filter.", THEME.Bad)
		return
	end

	local truncated = false
	if #dump > CONFIG.MaxGuiDumpChars then
		dump = dump:sub(1, CONFIG.MaxGuiDumpChars)
			.. "\n\n-- [cut off here -- the full dump is too big for the viewer, use Export to Editor]"
		truncated = true
	end

	headerLabel.Text = ("ALL SCRIPTS IN ONE  --  %d scripts, %d chars"):format(count, #dump)
	headerLabel.TextColor3 = THEME.Accent
	sourceBox.Text = dump
	sourceScroll.CanvasPosition = Vector2.zero

	focusAndSelectAll(sourceBox)

	if truncated then
		setStatus("Loaded but truncated. Everything is selected -- try Ctrl+C. If nothing lands on your clipboard, use Export to Editor.", THEME.Bad)
	else
		setStatus("All scripts loaded and selected -- try Ctrl+C. If nothing lands on your clipboard, use Export to Editor.", THEME.Good)
	end
end)

copyBtn.MouseButton1Click:Connect(function()
	if not selected then
		setStatus("No script selected.", THEME.Bad)
		return
	end
	if not selected.Source then
		setStatus("That script's source could not be read.", THEME.Bad)
		return
	end
	if not tryClipboard(selected.Source, selected.Name) then
		sourceBox.Text = selected.Source
		focusAndSelectAll(sourceBox)
		setStatus(("'%s' selected -- try Ctrl+C, or use Export to Editor."):format(selected.Name))
	end
end)

copyAllBtn.MouseButton1Click:Connect(function()
	local dump, count = buildDump()
	if count == 0 then
		setStatus("Nothing matches the filter.", THEME.Bad)
		return
	end
	if not tryClipboard(dump, count .. " scripts") then
		setStatus("No clipboard function available. Use Export to Editor, or Show All in One.", THEME.Bad)
	end
end)

