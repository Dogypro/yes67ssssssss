local allScripts = {}
local selected = nil
local rowButtons = {}

local function formatEntry(entry)
	local header = ("%s\n-- %s  [%s]  %d lines\n%s")
		:format(CONFIG.Separator, entry.Path, entry.Class, entry.Lines, CONFIG.Separator)
	local body = entry.Source or ("-- <unreadable: " .. tostring(entry.Error) .. ">")
	return header .. "\n" .. body
end

local function matchesFilter(entry, filter)
	if filter == "" then return true end
	local hay = (entry.Name .. " " .. entry.Path .. " " .. entry.Class):lower()
	return hay:find(filter, 1, true) ~= nil
end

-- Builds the combined dump text for whatever currently passes the search filter.
local function buildDump()
	local filter = searchBox.Text:lower()
	local parts, count = {}, 0

	table.insert(parts, ("-- Script dump of %s"):format(game.Name))
	table.insert(parts, ("-- Generated %s"):format(os.date("%Y-%m-%d %H:%M:%S")))
	table.insert(parts, "")

	for _, entry in ipairs(allScripts) do
		if matchesFilter(entry, filter) then
			table.insert(parts, formatEntry(entry))
			table.insert(parts, "")
			count += 1
		end
	end

	table.insert(parts, 3, ("-- %d scripts included"):format(count))
	return table.concat(parts, "\n"), count
end

--==============================================================================
-- METHOD 1: EXPORT TO THE REAL SCRIPT EDITOR  (the reliable one)
--==============================================================================

local function exportToEditor()
	local dump, count = buildDump()
	if count == 0 then
		setStatus("Nothing matches the filter.", THEME.Bad)
		return
	end

	local ServerStorage = game:GetService("ServerStorage")

	local old = ServerStorage:FindFirstChild(CONFIG.ExportFolderName)
	if old then old:Destroy() end

	exportFolder = Instance.new("Folder")
	exportFolder.Name = CONFIG.ExportFolderName
	exportFolder.Parent = ServerStorage

	-- Split into parts so the editor stays responsive.
	local chunks = {}
	if #dump <= CONFIG.MaxCharsPerExport then
		chunks[1] = dump
	else
		local pos = 1
		while pos <= #dump do
			local stop = math.min(pos + CONFIG.MaxCharsPerExport - 1, #dump)
			-- break on a newline so we never split a line in half
			if stop < #dump then
				local nl = dump:find("\n", stop)
				if nl then stop = nl end
			end
			table.insert(chunks, dump:sub(pos, stop))
			pos = stop + 1
		end
	end

	local made = {}
	for i, chunk in ipairs(chunks) do
		local m = Instance.new("ModuleScript")
		m.Name = (#chunks == 1) and "Dump" or ("Dump_Part" .. i)
		local ok, err = pcall(function()
			m.Source = "--[==[\n" .. chunk .. "\n]==]"
		end)
		if not ok then
			m.Source = "-- failed to write chunk: " .. tostring(err)
		end
		m.Parent = exportFolder
		table.insert(made, m)
	end

	-- Select in Explorer and open in the script editor.
	pcall(function()
		game:GetService("Selection"):Set(made)
	end)

	task.spawn(function()
		local ses = game:FindService("ScriptEditorService")
		if ses then
			for _, m in ipairs(made) do
				pcall(function() ses:OpenScriptDocumentAsync(m) end)
			end
		end
	end)

	setStatus(("Exported %d scripts to ServerStorage.%s (%d part%s). Click into the editor tab, then Ctrl+A, Ctrl+C.")
		:format(count, CONFIG.ExportFolderName, #made, #made == 1 and "" or "s"), THEME.Good)
end

--==============================================================================
-- METHOD 2 / 3: IN-GUI SELECT AND setclipboard
--==============================================================================

local function focusAndSelectAll(box)
	box:CaptureFocus()
	-- Focus resets the cursor, so the selection has to be applied a frame later.
	task.defer(function()
		task.wait()
		box.CursorPosition = #box.Text + 1
		box.SelectionStart = 1
	end)
end

local function tryClipboard(text, label)
	if #text == 0 then
		setStatus("Nothing to copy.", THEME.Bad)
		return false
	end
	if typeof(setclipboard) == "function" then
		local ok = pcall(setclipboard, text)
		if ok then
			setStatus(("Copied %s to clipboard (%d chars)."):format(label, #text), THEME.Good)
			return true
		end
	end
	return false
end

