--[[ ==========================================================================
     GAME DUMP v2  --  Delta / mobile executors

     WHAT CHANGED FROM v1
       scripts.txt   now ALWAYS written -- a full inventory of every script
                     found, with path, class, and why its source is missing
       strings.txt   NEW. Pulls string and number constants back out of every
                     loaded function. This is the closest thing to code that
                     exists on a client: remote names, config values, messages,
                     asset ids, thresholds.
       modules.txt   better coverage -- also pulls from getloadedmodules() and
                     retries with a longer timeout

     THE HARD LIMIT, PLAINLY
       Roblox compiles Lua to bytecode on its servers and ships only bytecode
       to clients. Source text is never transmitted. Your first run said
       "380 scripts, 0 with source" -- that is correct and expected, not a bug.
       No executor setting recovers it, and Delta has no decompiler.

       For YOUR OWN game, Studio reads Source directly and completely. That is
       the only way to get the real text of all 380 scripts.
     ========================================================================== ]]

local CONFIG = {
	Folder = "GameDump",
	MaxDepth = 25,
	MaxChildren = 4000,
	MaxTableDepth = 6,
	RequireTimeout = 4,
	MaxFunctions = 20000,
	MinStringLength = 3,
	YieldEvery = 300,
};

--[[ ---------- capability probe ---------- ]]

local canWrite = typeof(writefile) == "function";
local canFolder = typeof(makefolder) == "function";
local canClip = typeof(setclipboard) == "function";
local gcScan = (typeof(getgc) == "function" and getgc)
	or (typeof(get_gc_objects) == "function" and get_gc_objects) or nil;
local loadedModules = (typeof(getloadedmodules) == "function" and getloadedmodules) or nil;
local dbgConstants = (debug and typeof(debug.getconstants) == "function" and debug.getconstants) or nil;
local dbgUpvalues = (debug and typeof(debug.getupvalues) == "function" and debug.getupvalues) or nil;
local dbgInfo = (debug and typeof(debug.getinfo) == "function" and debug.getinfo) or nil;
local guiHost = (typeof(gethui) == "function" and gethui()) or game:GetService("CoreGui");

local Players = game:GetService("Players");

local ROOTS = {
	"ReplicatedStorage", "ReplicatedFirst", "Workspace", "Lighting",
	"StarterGui", "StarterPack", "StarterPlayer", "SoundService",
	"Teams", "MaterialService",
};

--[[ ---------- value printing ---------- ]]

local function shortValue(v)
	local t = typeof(v);
	if t == "string" then
		if #v > 300 then v = string.sub(v, 1, 300) .. "..."; end
		return string.format("%q", v);
	elseif t == "number" or t == "boolean" then
		return tostring(v);
	elseif t == "nil" then
		return "nil";
	elseif t == "Vector3" then
		return string.format("Vector3(%.2f, %.2f, %.2f)", v.X, v.Y, v.Z);
	elseif t == "CFrame" then
		local p = v.Position;
		return string.format("CFrame(%.2f, %.2f, %.2f)", p.X, p.Y, p.Z);
	elseif t == "Color3" then
		return string.format("Color3(%d, %d, %d)", v.R * 255, v.G * 255, v.B * 255);
	elseif t == "UDim2" then
		return string.format("UDim2(%.2f, %d, %.2f, %d)",
			v.X.Scale, v.X.Offset, v.Y.Scale, v.Y.Offset);
	elseif t == "EnumItem" then
		return tostring(v);
	elseif t == "Instance" then
		return "<" .. v.ClassName .. " " .. v:GetFullName() .. ">";
	elseif t == "function" then
		return "<function>";
	end
	return "<" .. t .. ">";
end

local function serialize(value, depth, seen, out)
	depth = depth or 0; seen = seen or {}; out = out or {};

	if type(value) ~= "table" then
		table.insert(out, shortValue(value));
		return out;
	end
	if seen[value] then table.insert(out, "<cycle>"); return out; end
	if depth >= CONFIG.MaxTableDepth then table.insert(out, "{...}"); return out; end
	seen[value] = true;

	local pad = string.rep("  ", depth + 1);
	local closePad = string.rep("  ", depth);
	local keys = {};
	for k in pairs(value) do table.insert(keys, k); end

	if #keys == 0 then
		table.insert(out, "{}"); seen[value] = nil; return out;
	end

	table.sort(keys, function(a, b) return tostring(a) < tostring(b); end);
	table.insert(out, "{\n");
	for _, k in ipairs(keys) do
		table.insert(out, pad .. "[" .. shortValue(k) .. "] = ");
		if not pcall(function() serialize(value[k], depth + 1, seen, out); end) then
			table.insert(out, "<error>");
		end
		table.insert(out, ",\n");
	end
	table.insert(out, closePad .. "}");
	seen[value] = nil;
	return out;
end

