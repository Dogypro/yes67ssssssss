--[[ ---------- extraction ---------- ]]

local summaryText = "";
local running = false;

local function dumpAll()
	if running then return; end
	running = true;
	dumpBtn.Text = "Working...";

	local counts = {objects = 0, scripts = 0, sourced = 0, modules = 0, remotes = 0, funcs = 0};
	local tree, remotes, scriptRows, moduleOut, stringOut = {}, {}, {}, {}, {};
	local moduleQueue, seenModule = {}, {};
	local processed = 0;

	--[[ 1. walk the instance tree ]]

	local function walk(inst, depth)
		if depth > CONFIG.MaxDepth then return; end
		processed = processed + 1;
		counts.objects = counts.objects + 1;

		if processed % CONFIG.YieldEvery == 0 then
			say("Scanning... " .. counts.objects .. " objects");
			task.wait();
		end

		table.insert(tree, string.rep("  ", depth) .. inst.ClassName .. ' "' .. inst.Name .. '"');

		if inst:IsA("RemoteEvent") or inst:IsA("RemoteFunction")
			or inst:IsA("BindableEvent") or inst:IsA("BindableFunction") then
			counts.remotes = counts.remotes + 1;
			table.insert(remotes, inst.ClassName .. "  " .. inst:GetFullName());
		end

		if inst:IsA("LuaSourceContainer") then
			counts.scripts = counts.scripts + 1;

			local gotSource, source = pcall(function() return inst.Source; end);
			local hasSource = gotSource and type(source) == "string" and #source > 0;

			if hasSource then
				counts.sourced = counts.sourced + 1;
				table.insert(scriptRows, string.rep("=", 74));
				table.insert(scriptRows, inst:GetFullName() .. "  [" .. inst.ClassName .. "]  SOURCE AVAILABLE");
				table.insert(scriptRows, string.rep("=", 74));
				table.insert(scriptRows, source);
				table.insert(scriptRows, "");
			else
				local why = inst:IsA("ModuleScript")
					and "no source on client -- live data in modules.txt"
					or  "no source on client -- bytecode only, constants in strings.txt";
				table.insert(scriptRows, string.format("%-56s %-14s %s",
					inst:GetFullName(), inst.ClassName, why));
			end

			if inst:IsA("ModuleScript") and not seenModule[inst] then
				seenModule[inst] = true;
				table.insert(moduleQueue, inst);
			end
		end

		local ok, kids = pcall(function() return inst:GetChildren(); end);
		if ok then
			local n = 0;
			for _, kid in ipairs(kids) do
				n = n + 1;
				if n > CONFIG.MaxChildren then break; end
				pcall(walk, kid, depth + 1);
			end
		end
	end

	for _, name in ipairs(ROOTS) do
		local ok, service = pcall(game.GetService, game, name);
		if ok and service then
			table.insert(tree, "");
			table.insert(tree, "#### " .. name .. " ####");
			pcall(walk, service, 0);
		end
	end

	local lp = Players.LocalPlayer;
	if lp and lp:FindFirstChild("PlayerGui") then
		table.insert(tree, "");
		table.insert(tree, "#### PlayerGui ####");
		pcall(walk, lp.PlayerGui, 0);
	end

	--[[ 2. modules the game already loaded, often more than the tree shows ]]

	if loadedModules then
		local ok, list = pcall(loadedModules);
		if ok and type(list) == "table" then
			for _, m in ipairs(list) do
				if typeof(m) == "Instance" and not seenModule[m] then
					seenModule[m] = true;
					table.insert(moduleQueue, m);
				end
			end
		end
	end

	--[[ 3. require every module for its live data ]]

	say("Reading " .. #moduleQueue .. " modules...");
	task.wait();

	local function safeRequire(m)
		local done, value = false, nil;
		task.spawn(function()
			local ok, res = pcall(require, m);
			value = ok and res or nil;
			done = true;
		end);
		local waited = 0;
		while not done and waited < CONFIG.RequireTimeout do
			task.wait(0.05);
			waited = waited + 0.05;
		end
		return value;
	end

	for i, m in ipairs(moduleQueue) do
		if i % 10 == 0 then
			say("Modules " .. i .. " / " .. #moduleQueue);
			task.wait();
		end
		local value = safeRequire(m);
		if value ~= nil then
			counts.modules = counts.modules + 1;
			table.insert(moduleOut, string.rep("=", 74));
			local ok, full = pcall(function() return m:GetFullName(); end);
			table.insert(moduleOut, ok and full or tostring(m.Name));
			table.insert(moduleOut, string.rep("=", 74));
			local pieces = {};
			pcall(function() serialize(value, 0, {}, pieces); end);
			table.insert(moduleOut, table.concat(pieces));
			table.insert(moduleOut, "");
		end
	end

	--[[ 4. constants and upvalues from every loaded function.
	       As close to the code as a client can get. ]]

	if gcScan and dbgConstants then
		say("Extracting constants from functions...");
		task.wait();

		local ok, objects = pcall(gcScan, true);
		if ok and type(objects) == "table" then
			local seenBlock = {};
			local scanned = 0;

			for _, obj in ipairs(objects) do
				if scanned >= CONFIG.MaxFunctions then break; end
				if type(obj) == "function" then
					scanned = scanned + 1;

					if scanned % 500 == 0 then
						say("Functions " .. scanned .. " scanned");
						task.wait();
					end

					local where = "?";
					if dbgInfo then
						local okI, info = pcall(dbgInfo, obj);
						if okI and type(info) == "table" then
							where = tostring(info.short_src or info.source or "?")
								.. ":" .. tostring(info.linedefined or "?");
						end
					end

					local bits = {};

					local okC, consts = pcall(dbgConstants, obj);
					if okC and type(consts) == "table" then
						for _, c in ipairs(consts) do
							local ct = type(c);
							if ct == "string" and #c >= CONFIG.MinStringLength then
								table.insert(bits, '  "' .. c .. '"');
							elseif ct == "number" then
								table.insert(bits, "  " .. tostring(c));
							end
						end
					end

					if dbgUpvalues then
						local okU, ups = pcall(dbgUpvalues, obj);
						if okU and type(ups) == "table" then
							for _, u in ipairs(ups) do
								if type(u) == "string" and #u >= CONFIG.MinStringLength then
									table.insert(bits, '  upvalue: "' .. u .. '"');
								elseif type(u) == "number" then
									table.insert(bits, "  upvalue: " .. tostring(u));
								end
							end
						end
					end

					if #bits > 0 then
						local block = where .. "\n" .. table.concat(bits, "\n");
						if not seenBlock[block] then
							seenBlock[block] = true;
							counts.funcs = counts.funcs + 1;
							table.insert(stringOut, string.rep("-", 74));
							table.insert(stringOut, block);
						end
					end
				end
			end
		end
	end

	--[[ 5. write everything ]]

	summaryText = table.concat({
		"GAME DUMP v2  --  " .. game.Name,
		"PlaceId  " .. tostring(game.PlaceId),
		"Time     " .. os.date("%Y-%m-%d %H:%M:%S"),
		"",
		"Objects              " .. counts.objects,
		"Scripts found        " .. counts.scripts,
		"  source readable    " .. counts.sourced,
		"Modules with data    " .. counts.modules,
		"Remotes              " .. counts.remotes,
		"Functions harvested  " .. counts.funcs,
		"",
		"getgc      " .. (gcScan and "yes" or "NO"),
		"constants  " .. (dbgConstants and "yes" or "NO"),
		"upvalues   " .. (dbgUpvalues and "yes" or "NO"),
		"",
		(counts.sourced == 0)
			and "Source is 0 because Roblox ships bytecode to clients, never text. strings.txt holds the constants recovered from that bytecode. Open the place in Studio for the real source."
			or  "Some source was readable, see scripts.txt.",
	}, "\n");

	if not canWrite then
		if canClip then pcall(setclipboard, summaryText); end
		say("No writefile in this executor. Summary copied instead.");
		dumpBtn.Text = "Dump everything"; running = false; return;
	end

	if canFolder then pcall(makefolder, CONFIG.Folder); end

	local files = {
		{"summary.txt", summaryText},
		{"scripts.txt", "SCRIPT INVENTORY -- " .. counts.scripts .. " found, "
			.. counts.sourced .. " with readable source\n\n" .. table.concat(scriptRows, "\n")},
		{"strings.txt", "CONSTANTS RECOVERED FROM " .. counts.funcs .. " FUNCTIONS\n\n"
			.. table.concat(stringOut, "\n")},
		{"modules.txt", table.concat(moduleOut, "\n")},
		{"tree.txt", table.concat(tree, "\n")},
		{"remotes.txt", table.concat(remotes, "\n")},
	};

	local written = 0;
	for _, entry in ipairs(files) do
		local name, body = entry[1], entry[2];
		if body and #body > 0 then
			if #body > 4000000 then
				local index, pos = 0, 1;
				while pos <= #body do
					index = index + 1;
					local stop = math.min(pos + 4000000, #body);
					local nl = string.find(body, "\n", stop, true);
					if nl then stop = nl; end
					if pcall(writefile, CONFIG.Folder .. "/"
						.. string.gsub(name, "%.txt", "") .. "_part" .. index .. ".txt",
						string.sub(body, pos, stop)) then
						written = written + 1;
					end
					pos = stop + 1;
					task.wait();
				end
			else
				if pcall(writefile, CONFIG.Folder .. "/" .. name, body) then
					written = written + 1;
				end
			end
		end
		task.wait();
	end

	say("Saved " .. written .. " files to " .. CONFIG.Folder .. "/\n"
		.. counts.scripts .. " scripts listed, " .. counts.funcs .. " functions harvested, "
		.. counts.modules .. " modules read.");

	dumpBtn.Text = "Dump everything";
	running = false;
end

dumpBtn.MouseButton1Click:Connect(function() task.spawn(dumpAll); end);

copyBtn.MouseButton1Click:Connect(function()
	if summaryText == "" then say("Run the dump first."); return; end
	if canClip then
		pcall(setclipboard, summaryText);
		say("Summary copied.");
	else
		say("No setclipboard here.");
	end
end);

say(table.concat({
	"writefile  " .. (canWrite and "yes" or "NO"),
	"getgc      " .. (gcScan and "yes" or "NO"),
	"constants  " .. (dbgConstants and "yes" or "NO"),
	"",
	"Tap Dump everything.",
}, "\n"));
