	Title              = "Script Dump Explorer",
	MaxDumpChars       = 3000000,  -- refuse Copy All beyond this, TextBoxes choke
	MaxPreviewChars    = 400000,   -- truncate a single script preview beyond this
	IncludeArchivable  = true,     -- set false to skip Archivable=false instances
	Separator          = string.rep("=", 78),
}

local CLASS_COLOR = {
	Script       = Color3.fromRGB(88, 166, 255),
	LocalScript  = Color3.fromRGB(118, 214, 140),
	ModuleScript = Color3.fromRGB(240, 186, 90),
}

