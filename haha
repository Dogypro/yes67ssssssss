	if not selected then
		setStatus("No script selected.", THEME.Bad)
		return
	end
	if not selected.Source then
		setStatus("That script's source could not be read.", THEME.Bad)
		return
	end
	copyToClipboard(selected.Source, selected.Name)
end)

copyAllBtn.MouseButton1Click:Connect(function()
	local filter = searchBox.Text:lower()
	local parts, count = {}, 0

	table.insert(parts, ("-- Script dump of %s -- %d total scripts found")
		:format(game.Name, #allScripts))
	table.insert(parts, "")

	for _, entry in ipairs(allScripts) do
		local haystack = (entry.Name .. " " .. entry.Path .. " " .. entry.Class):lower()
		if filter == "" or haystack:find(filter, 1, true) then
			table.insert(parts, formatEntry(entry))
			table.insert(parts, "")
			count += 1
		end
	end

	local label = (filter == "") and ("all " .. count .. " scripts")
		or (count .. " matching scripts")
	copyToClipboard(table.concat(parts, "\n"), label)
end)

rescan()

print("[ScriptDumpExplorer] Ready --", #allScripts, "scripts found.")
