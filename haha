--==============================================================================
-- SCANNING
--==============================================================================

local SCAN_ROOTS = {
	"Workspace", "Players", "Lighting", "ReplicatedFirst", "ReplicatedStorage",
	"ServerScriptService", "ServerStorage", "StarterGui", "StarterPack",
	"StarterPlayer", "SoundService", "Teams", "Chat", "TextChatService",
	"MaterialService", "TestService",
}

-- Returns the full path of an instance without the leading "game."
local function fullPath(inst)
	local ok, path = pcall(function()
		return inst:GetFullName()
	end)
	if not ok then
		return inst.Name
	end
	return (path:gsub("^game%.", ""))
end

-- Reads .Source, returning nil plus a reason on failure.
local function readSource(inst)
	local ok, result = pcall(function()
		return inst.Source
	end)
	if ok and type(result) == "string" then
		return result, nil
	end
	return nil, tostring(result)
end

local function collectScripts()
	local found = {}

	for _, serviceName in ipairs(SCAN_ROOTS) do
		local ok, service = pcall(game.GetService, game, serviceName)
		if ok and service then
			local ok2, descendants = pcall(service.GetDescendants, service)
			if ok2 then
				for _, inst in ipairs(descendants) do
					if inst:IsA("LuaSourceContainer") then
						if CONFIG.IncludeArchivable or inst.Archivable then
							local src, err = readSource(inst)
							table.insert(found, {
								Instance = inst,
								Name     = inst.Name,
								Class    = inst.ClassName,
								Path     = fullPath(inst),
								Source   = src,
								Error    = err,
								Lines    = src and (select(2, src:gsub("\n", "")) + 1) or 0,
								Chars    = src and #src or 0,
							})
						end
					end
				end
			end
		end
	end

	table.sort(found, function(a, b)
		if a.Class ~= b.Class then
			return a.Class < b.Class
		end
		return a.Path:lower() < b.Path:lower()
	end)

	return found
end

