--==============================================================================
-- CLIPBOARD
--==============================================================================

-- Hidden TextBox used for the select-all fallback so we never clobber the viewer.
local clipBox = new("TextBox", {
	Size = UDim2.fromOffset(1, 1),
	Position = UDim2.fromOffset(-5, -5),
	BackgroundTransparency = 1,
	TextTransparency = 1,
	Text = "",
	MultiLine = true,
	ClearTextOnFocus = false,
	Parent = screen,
})

local function copyToClipboard(text, label)
	if #text == 0 then
		setStatus("Nothing to copy.", THEME.Bad)
		return
	end
	if #text > CONFIG.MaxDumpChars then
		setStatus(("Too large to copy (%d chars, limit %d). Filter the list and copy in parts.")
			:format(#text, CONFIG.MaxDumpChars), THEME.Bad)
		return
	end

	-- Executor / plugin environments sometimes expose a real clipboard function.
	if typeof(setclipboard) == "function" then
		local ok = pcall(setclipboard, text)
		if ok then
			setStatus(("Copied %s to clipboard (%d chars)."):format(label, #text), THEME.Good)
			return
		end
	end

	clipBox.Text = text
	clipBox:CaptureFocus()
	clipBox.SelectionStart = 1
	clipBox.CursorPosition = #clipBox.Text + 1
	setStatus(("%s selected (%d chars) -- press Ctrl+C now."):format(label, #text), THEME.Good)
end

--==============================================================================
-- STATE + RENDERING
--==============================================================================

local allScripts = {}
local selected = nil
local rowButtons = {}

local function formatEntry(entry)
	local header = ("%s\n-- %s  [%s]  %d lines\n%s")
		:format(CONFIG.Separator, entry.Path, entry.Class, entry.Lines, CONFIG.Separator)
	local body = entry.Source or ("-- <unreadable: " .. tostring(entry.Error) .. ">")
	return header .. "\n" .. body
end

local function selectEntry(entry)
	selected = entry

	for _, btn in ipairs(rowButtons) do
		btn.BackgroundColor3 = (btn:GetAttribute("Path") == entry.Path) and THEME.Panel2 or THEME.Bg
	end

	headerLabel.Text = ("%s  [%s]  -- %d lines, %d chars")
		:format(entry.Path, entry.Class, entry.Lines, entry.Chars)
	headerLabel.TextColor3 = CLASS_COLOR[entry.Class] or THEME.Text

	local src = entry.Source
	if not src then
		sourceBox.Text = "-- Source could not be read.\n-- " .. tostring(entry.Error)
			.. "\n\n-- This happens when the code runs at an identity without PluginSecurity."
			.. "\n-- Run it from the Studio Command Bar or as a plugin."
	elseif #src > CONFIG.MaxPreviewChars then
		sourceBox.Text = src:sub(1, CONFIG.MaxPreviewChars)
			.. ("\n\n-- [preview truncated at %d chars -- use Copy This Script for the full text]")
				:format(CONFIG.MaxPreviewChars)
	else
		sourceBox.Text = src
	end

	sourceScroll.CanvasPosition = Vector2.zero
end

local function buildRow(entry, index)
	local row = new("TextButton", {
		Size = UDim2.new(1, -6, 0, 40),
		BackgroundColor3 = THEME.Bg,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		LayoutOrder = index,
		Parent = listScroll,
	}, { corner(6) })

	row:SetAttribute("Path", entry.Path)

	new("Frame", {
		Size = UDim2.new(0, 3, 1, -10),
		Position = UDim2.fromOffset(0, 5),
		BackgroundColor3 = CLASS_COLOR[entry.Class] or THEME.TextDim,
		BorderSizePixel = 0,
		Parent = row,
	}, { corner(2) })

	new("TextLabel", {
		Size = UDim2.new(1, -60, 0, 16),
		Position = UDim2.fromOffset(10, 4),
		BackgroundTransparency = 1,
		Text = entry.Name,
		TextColor3 = entry.Source and THEME.Text or THEME.Bad,
		TextSize = 13,
		Font = Enum.Font.GothamMedium,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = row,
	})

	new("TextLabel", {
		Size = UDim2.new(1, -60, 0, 14),
		Position = UDim2.fromOffset(10, 21),
		BackgroundTransparency = 1,
		Text = entry.Path,
		TextColor3 = THEME.TextDim,
		TextSize = 11,
		Font = Enum.Font.Code,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = row,
	})

	new("TextLabel", {
		Size = UDim2.fromOffset(44, 40),
		Position = UDim2.new(1, -48, 0, 0),
		BackgroundTransparency = 1,
		Text = entry.Lines .. "L",
		TextColor3 = THEME.TextDim,
		TextSize = 11,
		Font = Enum.Font.Code,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = row,
	})

	row.MouseEnter:Connect(function()
		if selected ~= entry then
			row.BackgroundColor3 = THEME.Panel2
		end
	end)
	row.MouseLeave:Connect(function()
		if selected ~= entry then
			row.BackgroundColor3 = THEME.Bg
		end
	end)
	row.MouseButton1Click:Connect(function()
		selectEntry(entry)
	end)

	table.insert(rowButtons, row)
	return row
end

local function renderList(filter)
	for _, child in ipairs(listScroll:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end
	table.clear(rowButtons)

	filter = (filter or ""):lower()
	local shown, unreadable = 0, 0

	for i, entry in ipairs(allScripts) do
		local haystack = (entry.Name .. " " .. entry.Path .. " " .. entry.Class):lower()
		if filter == "" or haystack:find(filter, 1, true) then
			buildRow(entry, i)
			shown += 1
			if not entry.Source then
				unreadable += 1
			end
		end
	end

	local msg = ("%d of %d scripts shown"):format(shown, #allScripts)
	if unreadable > 0 then
		msg ..= (" (%d unreadable)"):format(unreadable)
	end
	setStatus(msg)
	return shown
end

local function rescan()
	setStatus("Scanning...")
	allScripts = collectScripts()
	selected = nil
	headerLabel.Text = "Select a script from the list"
	headerLabel.TextColor3 = THEME.TextDim
	sourceBox.Text = ""
	renderList(searchBox.Text)
end

