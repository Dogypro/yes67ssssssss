	end)
	row.MouseLeave:Connect(function()
		if selected ~= entry then row.BackgroundColor3 = THEME.Bg end
	end)
	row.MouseButton1Click:Connect(function() selectEntry(entry) end)

	table.insert(rowButtons, row)
end

local function renderList()
	for _, child in ipairs(listScroll:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	table.clear(rowButtons)

	local filter = searchBox.Text:lower()
	local shown, unreadable = 0, 0

	for i, entry in ipairs(allScripts) do
		if matchesFilter(entry, filter) then
			buildRow(entry, i)
			shown += 1
			if not entry.Source then unreadable += 1 end
		end
	end

	local msg = ("%d of %d scripts shown"):format(shown, #allScripts)
	if unreadable > 0 then msg ..= (" (%d unreadable)"):format(unreadable) end
	setStatus(msg)
end

-- Figures out whether this execution context is allowed to read .Source at all,
-- so we can tell the user WHY the code is missing instead of showing blanks.
local function diagnoseSourceAccess()
	local probe = Instance.new("ModuleScript")
	local canWrite = pcall(function() probe.Source = "-- probe" end)
	local canRead = pcall(function() return probe.Source end)
	probe:Destroy()

	local RunService = game:GetService("RunService")
	local running = RunService:IsRunning()

	return {
		CanRead = canRead and canWrite,
		IsPlayMode = running,
	}
end

local NO_ACCESS_MESSAGE = [[
====================================================================
  THE SCRIPT LIST LOADED, BUT THE CODE IS EMPTY
====================================================================

Reading Script.Source needs PluginSecurity. Names and paths are
readable at any permission level, which is why you can see the list
but not the code.

Fix it with whichever of these applies:

1. RUN IT FROM THE COMMAND BAR, NOT A SCRIPT.
   View > Command Bar, paste the file, press Enter.
   Pasting this into a Script/LocalScript and pressing Play will
   never work -- game scripts cannot read Source. Ever.

2. STOP PLAY MODE FIRST.
   If the red Stop button is showing, hit it. The command bar drops
   to a lower permission level during Play/Run.
   Go back to Edit mode, then paste and run.

3. IF YOU ARE IN AN EXECUTOR, NOT STUDIO.
   Executors cannot read .Source either -- the property is stripped
   from the client entirely. There is no version of this that reads
   another game's server code from a running client.

Open the place in Studio in Edit mode and run this from the command
bar. That is the setup this tool is built for.
]]

local function rescan()
	setStatus("Scanning...")
	allScripts = collectScripts()
	selected = nil
	sourceBox.Text = ""
	renderList()

	local readable = 0
	for _, e in ipairs(allScripts) do
		if e.Source then readable += 1 end
	end

	if #allScripts > 0 and readable == 0 then
		local diag = diagnoseSourceAccess()
		headerLabel.Text = diag.IsPlayMode
			and "NO SOURCE ACCESS -- you are in Play mode, stop it and rerun in Edit mode"
			or  "NO SOURCE ACCESS -- run this from the Studio Command Bar in Edit mode"
		headerLabel.TextColor3 = THEME.Bad
		sourceBox.Text = NO_ACCESS_MESSAGE
		setStatus(("Found %d scripts but could read 0 of them. See the panel on the right.")
			:format(#allScripts), THEME.Bad)
		warn("[ScriptDump] " .. NO_ACCESS_MESSAGE)
	else
		headerLabel.Text = "Select a script from the list"
		headerLabel.TextColor3 = THEME.TextDim
		setStatus(("%d of %d scripts readable."):format(readable, #allScripts),
			readable == #allScripts and THEME.Good or THEME.Bad)
	end
end

--==============================================================================
-- WIRING
--==============================================================================

searchBox:GetPropertyChangedSignal("Text"):Connect(renderList)
refreshBtn.MouseButton1Click:Connect(rescan)
exportBtn.MouseButton1Click:Connect(exportToEditor)

copyBtn.MouseButton1Click:Connect(function()
	if not selected then
		setStatus("No script selected.", THEME.Bad)
		return
	end
	if not selected.Source then
		setStatus("That script's source could not be read.", THEME.Bad)
		return
	end
	if not tryClipboard(selected.Source, selected.Name) then
		sourceBox.Text = selected.Source
		focusAndSelectAll(sourceBox)
		setStatus(("'%s' selected -- try Ctrl+C, or use Export to Editor."):format(selected.Name))
	end
end)

saveBtn.MouseButton1Click:Connect(saveToFile)
viewerBtn.MouseButton1Click:Connect(sendToViewer)

rescan()
print("[ScriptDump] Ready. " .. #allScripts .. " scripts found. Use 'Export to Editor' to get the text out.")

--[[
	================================================================================
	SENDING TO THE HTML VIEWER
	================================================================================

	A browser page cannot listen on a port -- only a server can. So dump_server.py
	does the listening, and viewer.html reads from it. Both are needed.

	  1. python3 dump_server.py
	  2. Studio: File > Game Settings > Security > Allow HTTP Requests = ON
	  3. Open http://localhost:8080 in your browser
	  4. Click "Send to Viewer" here

	The viewer updates live as batches arrive. Copy works properly there, because
	browsers have a real clipboard API and Studio does not.
]]
