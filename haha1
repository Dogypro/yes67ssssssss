	if count == 0 then
		setStatus("Nothing matches the filter.", THEME.Bad)
		return
	end

	local truncated = false
	if #dump > CONFIG.MaxGuiDumpChars then
		dump = dump:sub(1, CONFIG.MaxGuiDumpChars)
			.. "\n\n-- [cut off here -- the full dump is too big for the viewer, use Export to Editor]"
		truncated = true
	end

	headerLabel.Text = ("ALL SCRIPTS IN ONE  --  %d scripts, %d chars"):format(count, #dump)
	headerLabel.TextColor3 = THEME.Accent
	sourceBox.Text = dump
	sourceScroll.CanvasPosition = Vector2.zero

	focusAndSelectAll(sourceBox)

	if truncated then
		setStatus("Loaded but truncated. Everything is selected -- try Ctrl+C. If nothing lands on your clipboard, use Export to Editor.", THEME.Bad)
	else
		setStatus("All scripts loaded and selected -- try Ctrl+C. If nothing lands on your clipboard, use Export to Editor.", THEME.Good)
	end
end)

copyBtn.MouseButton1Click:Connect(function()
	if not selected then
		setStatus("No script selected.", THEME.Bad)
		return
	end
	if not selected.Source then
		setStatus("That script's source could not be read.", THEME.Bad)
		return
	end
	if not tryClipboard(selected.Source, selected.Name) then
		sourceBox.Text = selected.Source
		focusAndSelectAll(sourceBox)
		setStatus(("'%s' selected -- try Ctrl+C, or use Export to Editor."):format(selected.Name))
	end
end)

saveBtn.MouseButton1Click:Connect(saveToFile)

rescan()
print("[ScriptDump] Ready. " .. #allScripts .. " scripts found. Use 'Export to Editor' to get the text out.")

--[[
	================================================================================
	GETTING A REAL FILE OUT OF STUDIO VIA HTTP
	================================================================================

	1. Save dump_server.py somewhere and run it:   python3 dump_server.py
	2. In Studio: File > Game Settings > Security > Allow HTTP Requests = ON
	3. Set CONFIG.HttpEndpoint above to "http://localhost:8080/dump"
	4. Click Save to File.

	The server writes <PlaceName>_<timestamp>.txt into whatever folder you ran
	it from, plus a scripts/ subfolder with one .lua per script.

	If you'd rather not run a server, just click Save to File with HttpEndpoint
	left empty. It builds ServerStorage.ScriptDump and selects it -- right-click
	that folder in Explorer and choose "Save to File..." for a .rbxmx on disk.
]]
