local function selectEntry(entry)
	selected = entry

	for _, btn in ipairs(rowButtons) do
		btn.BackgroundColor3 = (btn:GetAttribute("Path") == entry.Path)
			and THEME.Panel2 or THEME.Bg
	end

	headerLabel.Text = ("%s  [%s]  -- %d lines, %d chars")
		:format(entry.Path, entry.Class, entry.Lines, entry.Chars)
	headerLabel.TextColor3 = CLASS_COLOR[entry.Class] or THEME.Text

	local src = entry.Source
	if not src then
		sourceBox.Text = "-- Source could not be read.\n-- " .. tostring(entry.Error)
	elseif #src > CONFIG.MaxPreviewChars then
		sourceBox.Text = src:sub(1, CONFIG.MaxPreviewChars)
			.. "\n\n-- [preview truncated -- use Export to Editor for the full text]"
	else
		sourceBox.Text = src
	end

	sourceScroll.CanvasPosition = Vector2.zero
end

