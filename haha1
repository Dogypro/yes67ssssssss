local allScripts = {}
local selected = nil
local rowButtons = {}

local function formatEntry(entry)
	local header = ("%s\n-- %s  [%s]  %d lines\n%s")
		:format(CONFIG.Separator, entry.Path, entry.Class, entry.Lines, CONFIG.Separator)
	local body = entry.Source or ("-- <unreadable: " .. tostring(entry.Error) .. ">")
	return header .. "\n" .. body
end

local function matchesFilter(entry, filter)
	if filter == "" then return true end
	local hay = (entry.Name .. " " .. entry.Path .. " " .. entry.Class):lower()
	return hay:find(filter, 1, true) ~= nil
end

-- Builds the combined dump text for whatever currently passes the search filter.
local function buildDump()
	local filter = searchBox.Text:lower()
	local parts, count = {}, 0

	table.insert(parts, ("-- Script dump of %s"):format(game.Name))
	table.insert(parts, ("-- Generated %s"):format(os.date("%Y-%m-%d %H:%M:%S")))
	table.insert(parts, "")

	for _, entry in ipairs(allScripts) do
		if matchesFilter(entry, filter) then
			table.insert(parts, formatEntry(entry))
			table.insert(parts, "")
			count += 1
		end
	end

	table.insert(parts, 3, ("-- %d scripts included"):format(count))
	return table.concat(parts, "\n"), count
end

--==============================================================================
-- SAVE TO FILE
--==============================================================================

-- Turns "ReplicatedStorage.Modules.Foo" into a filesystem-safe relative path.
local function safePath(str)
	return (str:gsub("[^%w%._%-/]", "_"))
end

-- METHOD 1: writefile() -- exists in executors, never in Studio.
local function saveViaWriteFile(dump, count)
	if typeof(writefile) ~= "function" then return false end

	local root = CONFIG.OutputFolder
	if typeof(makefolder) == "function" then
		pcall(makefolder, root)
	end

	local stamp = os.date("%Y%m%d_%H%M%S")
	local mainFile = ("%s/%s_%s.txt"):format(root, safePath(game.Name), stamp)

	local ok, err = pcall(writefile, mainFile, dump)
	if not ok then
		setStatus("writefile failed: " .. tostring(err), THEME.Bad)
		return true -- it exists, it just broke; don't fall through
	end

	local written = 1

	if CONFIG.WritePerScript then
		local subFolder = root .. "/scripts_" .. stamp
		if typeof(makefolder) == "function" then
			pcall(makefolder, subFolder)
		end

		local filter = searchBox.Text:lower()
		local seen = {}

		for _, entry in ipairs(allScripts) do
			if matchesFilter(entry, filter) and entry.Source then
				local name = safePath(entry.Path)
				-- flatten the path so we don't need nested makefolder calls
				name = name:gsub("/", "_")
				if seen[name] then
					seen[name] += 1
					name = name .. "_" .. seen[name]
				else
					seen[name] = 1
				end
				local okW = pcall(writefile, ("%s/%s.lua"):format(subFolder, name), entry.Source)
				if okW then written += 1 end
			end
		end
	end

	setStatus(("Saved %d files to /%s -- combined dump is %s (%d scripts, %d chars).")
		:format(written, root, mainFile, count, #dump), THEME.Good)
	return true
end

-- METHOD 2: POST to a local server that writes the file for you.
local function saveViaHttp(dump, count)
	if CONFIG.HttpEndpoint == "" then return false end

	local HttpService = game:GetService("HttpService")
	local payload = HttpService:JSONEncode({
		place = game.Name,
		placeId = game.PlaceId,
		scriptCount = count,
		generated = os.date("%Y-%m-%d %H:%M:%S"),
		dump = dump,
	})

	local ok, err = pcall(function()
		return HttpService:PostAsync(
			CONFIG.HttpEndpoint, payload, Enum.HttpContentType.ApplicationJson, false)
	end)

	if ok then
		setStatus(("POSTed %d scripts (%d chars) to %s -- check the folder your server is running in.")
			:format(count, #dump, CONFIG.HttpEndpoint), THEME.Good)
	else
		setStatus("HTTP POST failed: " .. tostring(err)
			.. " -- is the local server running and HTTP enabled in Game Settings?", THEME.Bad)
	end
	return true
end

-- METHOD 3: build it in ServerStorage so Explorer's "Save to File..." can grab it.
local function saveViaRbxmx(dump, count)
	local ServerStorage = game:GetService("ServerStorage")

	local old = ServerStorage:FindFirstChild(CONFIG.ExportFolderName)
	if old then old:Destroy() end

	exportFolder = Instance.new("Folder")
	exportFolder.Name = CONFIG.ExportFolderName
	exportFolder.Parent = ServerStorage

	local chunks = {}
	if #dump <= CONFIG.MaxCharsPerExport then
		chunks[1] = dump
	else
		local pos = 1
		while pos <= #dump do
			local stop = math.min(pos + CONFIG.MaxCharsPerExport - 1, #dump)
			if stop < #dump then
				local nl = dump:find("\n", stop)
				if nl then stop = nl end
			end
			table.insert(chunks, dump:sub(pos, stop))
			pos = stop + 1
		end
	end

	local made = {}
	for i, chunk in ipairs(chunks) do
		local m = Instance.new("ModuleScript")
		m.Name = (#chunks == 1) and "Dump" or ("Dump_Part" .. i)
		local ok, err = pcall(function()
			m.Source = "--[==[\n" .. chunk .. "\n]==]"
		end)
		if not ok then m.Source = "-- failed to write chunk: " .. tostring(err) end
		m.Parent = exportFolder
		table.insert(made, m)
	end

	pcall(function()
		game:GetService("Selection"):Set({ exportFolder })
	end)

	setStatus(("Built %d scripts into ServerStorage.%s and selected it. Right-click that folder in Explorer > 'Save to File...' to write the .rbxmx to disk.")
		:format(count, CONFIG.ExportFolderName), THEME.Good)
	return true
end

local function saveToFile()
	local dump, count = buildDump()
	if count == 0 then
		setStatus("Nothing matches the filter.", THEME.Bad)
		return
	end

	if saveViaWriteFile(dump, count) then return end
	if saveViaHttp(dump, count) then return end
	saveViaRbxmx(dump, count)
end

--==============================================================================
-- EXPORT TO THE SCRIPT EDITOR
--==============================================================================

local function exportToEditor()
	local dump, count = buildDump()
	if count == 0 then
		setStatus("Nothing matches the filter.", THEME.Bad)
		return
	end

	saveViaRbxmx(dump, count)

	task.spawn(function()
		local ses = game:FindService("ScriptEditorService")
		if ses and exportFolder then
			for _, m in ipairs(exportFolder:GetChildren()) do
				pcall(function() ses:OpenScriptDocumentAsync(m) end)
			end
		end
	end)

	setStatus(("Opened %d scripts in the editor. Click the tab, then Ctrl+A, Ctrl+C.")
		:format(count), THEME.Good)
end

--==============================================================================
-- METHOD 2 / 3: IN-GUI SELECT AND setclipboard
--==============================================================================

local function focusAndSelectAll(box)
	box:CaptureFocus()
	-- Focus resets the cursor, so the selection has to be applied a frame later.
	task.defer(function()
		task.wait()
		box.CursorPosition = #box.Text + 1
		box.SelectionStart = 1
	end)
end

local function tryClipboard(text, label)
	if #text == 0 then
		setStatus("Nothing to copy.", THEME.Bad)
		return false
	end
	if typeof(setclipboard) == "function" then
		local ok = pcall(setclipboard, text)
		if ok then
			setStatus(("Copied %s to clipboard (%d chars)."):format(label, #text), THEME.Good)
			return true
		end
	end
	return false
end

